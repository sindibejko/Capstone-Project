# Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Load dataset
df = pd.read_csv("/content/2022 AD Murban Crude Oil Futures Historical Data.csv")

# Preprocessing
# Convert 'Date' column to datetime format and sort by date
df['Date'] = pd.to_datetime(df['Date'], format="%m/%d/%Y")
df = df.sort_values(by='Date')

# Convert 'Change %' to numeric (remove % and convert to float)
df['Change %'] = df['Change %'].str.rstrip('%').astype('float')

# Change name of 'Vol.' column to 'Volume'
df.rename(columns={'Vol.': 'Volume'}, inplace=True)

# Convert 'Vol.' column to remove the 'K' with thousands multiplier
df['Volume'] = df['Volume'].str.rstrip('K').astype('float') * 1000

# Set 'Date' as index
df.set_index("Date", inplace=True)

# Ensure business days only
df = df.asfreq('B')

# Forward-fill missing prices
df['Price'].fillna(method='ffill', inplace=True)

# Stationarity Check
from statsmodels.tsa.stattools import adfuller
result = adfuller(df['Price'])
print('ADF Statistic:', result[0])
print('p-value:', result[1]) # If > 0.05, series is NOT stationary

# First-Order Differencing
df['Price_Diff'] = df['Price'].diff().dropna()

# Run test again
result_diff = adfuller(df['Price_Diff'].dropna())
print('ADF Statistic:', result_diff[0])
print('p-value:', result_diff[1])

# Auto-Correlation Function (ACF) and Partial Auto-Correlation Function (PACF)
from statsmodels.graphics.tsaplots import plot_acf, plot_pacf

fig, ax = plt.subplots(2, figsize=(10,6))
plot_acf(df['Price_Diff'].dropna(), ax=ax[0]) # Check q
plot_pacf(df['Price_Diff'].dropna(), ax=ax[1]) # Check p
plt.show()

# Fit the ARIMA(1,1,1) model
from statsmodels.tsa.arima.model import ARIMA

model = ARIMA(df['Price'], order=(1,1,1))
model_fit = model.fit()
print(model_fit.summary())

# Check Residuals
import matplotlib.pyplot as plt
import seaborn as sns

residuals = model_fit.resid

# Plot residuals
plt.figure(figsize=(10,5))
sns.histplot(residuals, bins=20, kde=True)
plt.title("Residual Distribution")
plt.show()

# Residual Time Series Plot
plt.figure(figsize=(10,5))
plt.plot(residuals)
plt.axhline(y=0, color='r', linestyle='--')
plt.title("Residuals Time Series")
plt.show()

# Generate Forecasts
df['Forecast_1_1_1'] = model_fit.predict(start=len(df)-60, end=len(df)-1, typ='levels')
print(df[['Price', 'Forecast_1_1_1']].tail(10))

# Predicted vs. Actual Crude Oil Prices Plot
df[['Price', 'Forecast_1_1_1']].iloc[-60:].plot(figsize=(10,5))

# Error Analysis: RMSE / MAE
from sklearn.metrics import mean_absolute_error
mae = mean_absolute_error(df['Price'].iloc[-60:], df['Forecast_1_1_1'].iloc[-60:])
print("Mean Absolute Error:", mae)


# Hedging Decision Simulation
# Get actual and predicted price arrays
actual = df['Price'].iloc[-60:].values
predicted = df['Forecast_1_1_1'].values

# Define the decision logic
def classify_action(current_price, next_price, threshold):
    diff = next_price - current_price
    if diff > threshold:
        return "BUY"
    elif diff < -threshold:
        return "SELL"
    else:
        return "HOLD"

# Evaluate over multiple thresholds
thresholds = [0.25, 0.5, 0.75, 1.0]
print("Threshold | Accuracy (%) | Correct / Total")
print("-------------------------------------------")

for thresh in thresholds:
    correct = 0
    total = len(actual) - 1

    for i in range(total):
        pred_action = classify_action(predicted[i], predicted[i+1], threshold=thresh)
        actual_action = classify_action(actual[i], actual[i+1], threshold=thresh)

        if pred_action == actual_action:
            correct += 1

    accuracy = correct / total * 100
    print(f"{thresh:<9} | {accuracy:>11.2f}% | {correct} / {total}")

# Redefine classifier
def classify_action(current, next_, threshold=1.0):
    diff = next_ - current
    if diff > threshold:
        return "BUY"
    elif diff < -threshold:
        return "SELL"
    else:
        return "HOLD"


# Choose 5 unique random indices from the valid range
import random
random_days = sorted(random.sample(range(len(actual) - 1), 5))

print("\nSample Day | Predicted Action | Actual Action | Match")
print("--------------------------------------------------------")

for i in random_days:
    pred_action = classify_action(predicted[i], predicted[i+1], threshold=1.0)
    actual_action = classify_action(actual[i], actual[i+1], threshold=1.0)
    match = "✅" if pred_action == actual_action else "❌"

    print(f"{i:<11} | {pred_action:^16} | {actual_action:^14} | {match}")
