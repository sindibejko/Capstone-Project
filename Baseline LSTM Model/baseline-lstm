# Libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Load dataset
df = pd.read_csv("/content/2022 AD Murban Crude Oil Futures Historical Data.csv")

# Preprocessing
df['Date'] = pd.to_datetime(df['Date'], format="%m/%d/%Y")
df = df.sort_values(by='Date')
df['Change %'] = df['Change %'].str.rstrip('%').astype('float')
df.rename(columns={'Vol.': 'Volume'}, inplace=True)
df['Volume'] = df['Volume'].str.rstrip('K').astype('float') * 1000
df = df[['Date', 'Price', 'Volume']]
df.set_index('Date', inplace=True)

# Normalize
from sklearn.preprocessing import MinMaxScaler
scaler_price = MinMaxScaler()
scaler_volume = MinMaxScaler()
df['Price_Scaled'] = scaler_price.fit_transform(df[['Price']])
df['Volume_Scaled'] = scaler_volume.fit_transform(df[['Volume']])
df_scaled = df[['Price_Scaled', 'Volume_Scaled']]

# Create Sequences
def create_sequences(data, seq_length):
    X, y = [], []
    for i in range(len(data) - seq_length):
        X.append(data[i:i+seq_length])
        y.append(data[i+seq_length][0])  # Predicting Price only
    return np.array(X), np.array(y)

seq_length = 10
X, y = create_sequences(df_scaled.values, seq_length)

# Train-test split
from sklearn.model_selection import train_test_split
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, shuffle=False)

# Final LSTM Model with Best Hyperparameters
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dropout, Dense
from tensorflow.keras.optimizers import Adam

model = Sequential()
model.add(LSTM(units=96, return_sequences=False, input_shape=(X_train.shape[1], X_train.shape[2])))
model.add(Dropout(rate=0.1))
model.add(Dense(1))
model.compile(optimizer=Adam(learning_rate=0.01), loss='mse')

# Train
history = model.fit(X_train, y_train, epochs=50, batch_size=16,
                    validation_data=(X_test, y_test), verbose=1)

# Predict
y_pred_scaled = model.predict(X_test)
y_pred = scaler_price.inverse_transform(y_pred_scaled)
y_true = scaler_price.inverse_transform(y_test.reshape(-1, 1))

# Plot Predicted vs Actual
plt.figure(figsize=(10,5))
plt.plot(y_true, label='Actual Price')
plt.plot(y_pred, label='Predicted Price')
plt.title("LSTM (Final) - Actual vs. Predicted Murban Prices")
plt.xlabel("Time Step")
plt.ylabel("Price (USD)")
plt.legend()
plt.grid()
plt.show()

# Error Analysis: RMSE / MAE
from sklearn.metrics import mean_absolute_error, mean_squared_error
mae = mean_absolute_error(y_true, y_pred)
rmse = np.sqrt(mean_squared_error(y_true, y_pred))
print("Mean Absolute Error:", round(mae, 4))
print("Root Mean Squared Error:", round(rmse, 4))

# Residuals Plot
residuals = y_true - y_pred
plt.figure(figsize=(10, 4))
plt.plot(residuals)
plt.title("Residuals over Time")
plt.xlabel("Time Step")
plt.ylabel("Prediction Error")
plt.grid(True)
plt.show()

# Hedging Decision Simulation
# Get actual and predicted price arrays
actual = y_true.flatten()
predicted = y_pred.flatten()

def classify_action(current_price, next_price, threshold):
    diff = next_price - current_price
    if diff > threshold:
        return "BUY"
    elif diff < -threshold:
        return "SELL"
    else:
        return "HOLD"

# Evaluate over multiple thresholds
thresholds = [0.25, 0.5, 0.75, 1.0]
print("Threshold | Accuracy (%) | Correct / Total")
print("-------------------------------------------")

for thresh in thresholds:
    correct = 0
    total = len(actual) - 1

    for i in range(total):
        pred_action = classify_action(predicted[i], predicted[i+1], threshold=thresh)
        actual_action = classify_action(actual[i], actual[i+1], threshold=thresh)

        if pred_action == actual_action:
            correct += 1

    accuracy = correct / total * 100
    print(f"{thresh:<9} | {accuracy:>11.2f}% | {correct} / {total}")

# Sample day evaluation
import random
random_days = sorted(random.sample(range(len(actual) - 1), 5))

print("\nSample Day | Predicted Action | Actual Action | Match")
print("--------------------------------------------------------")

for i in random_days:
    pred_action = classify_action(predicted[i], predicted[i+1], threshold=1.0)
    actual_action = classify_action(actual[i], actual[i+1], threshold=1.0)
    match = "✅" if pred_action == actual_action else "❌"
    print(f"{i:<11} | {pred_action:^16} | {actual_action:^14} | {match}")
