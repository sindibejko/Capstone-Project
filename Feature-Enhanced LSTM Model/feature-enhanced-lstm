# Libraries
import os, random
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import requests
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error
from tensorflow.keras import layers, models, optimizers
import tensorflow as tf
import nltk
from nltk.sentiment import SentimentIntensityAnalyzer

# Setup and seeding
os.environ['TF_DETERMINISTIC_OPS'] = '1'
os.environ['TF_CUDNN_DETERMINISTIC'] = '1'
os.environ['CUDA_VISIBLE_DEVICES'] = ''
random.seed(0)
np.random.seed(0)
tf.random.set_seed(42)

# Download sentiment analyzer
nltk.download('vader_lexicon')

# Load Data
murban = pd.read_csv("/content/Abu Dhabi Murban Crude Oil Futures Historical Data.csv")
brent = pd.read_csv("/content/Brent Oil Futures Historical Data.csv")
ovx = pd.read_csv("/content/OVXCLS.csv")

# Preprocessing
murban['Date'] = pd.to_datetime(murban['Date'])
brent['Date'] = pd.to_datetime(brent['Date'])
ovx.rename(columns={'observation_date': 'Date'}, inplace=True)
ovx['Date'] = pd.to_datetime(ovx['Date'])

def clean_volume(s):
    if isinstance(s, str):
        if s.endswith('K'): return float(s[:-1]) * 1e3
        if s.endswith('M'): return float(s[:-1]) * 1e6
        return float(s.replace(',', ''))
    return np.nan

murban['Vol.'] = murban['Vol.'].apply(clean_volume)
brent['Vol.'] = brent['Vol.'].apply(clean_volume)

for df in (murban, brent, ovx):
    df.sort_values('Date', inplace=True)
    df.reset_index(drop=True, inplace=True)

# Feature Engineering
def add_atr(df, n=14):
    hl = df['High'] - df['Low']
    hc = (df['High'] - df['Price'].shift()).abs()
    lc = (df['Low'] - df['Price'].shift()).abs()
    tr = pd.concat([hl, hc, lc], axis=1).max(axis=1)
    df[f'ATR_{n}'] = tr.rolling(n).mean()
    return df

def add_vol(df, n=10):
    df['Returns'] = df['Price'].pct_change()
    df[f'VOL_{n}'] = df['Returns'].rolling(n).std()
    return df

murban = add_atr(murban, 14)
murban = add_vol(murban, 10)
murban.dropna(inplace=True)
murban.reset_index(drop=True, inplace=True)

murban['ROC_5'] = murban['Price'].pct_change(periods=5)
murban.dropna(inplace=True)
murban.reset_index(drop=True, inplace=True)

# Merge External Data
brent = brent.rename(columns={'Price': 'Brent_Price'})[['Date', 'Brent_Price']]
ovx = ovx.rename(columns={'OVXCLS': 'OVX'})[['Date', 'OVX']]
merged = (murban
          .merge(brent, on='Date', how='left')
          .merge(ovx, on='Date', how='left'))
merged[['Brent_Price', 'OVX']] = merged[['Brent_Price', 'OVX']].fillna(method='ffill')
merged.rename(columns={'Vol.': 'Volume'}, inplace=True)

# Add Sentiment
sia = SentimentIntensityAnalyzer()
def get_gdelt_sentiment(dt):
    qs = (
        "https://api.gdeltproject.org/api/v2/doc/doc"
        f"?query=crude+oil+UAE&mode=ArtList&format=json"
        f"&startdatetime={dt.strftime('%Y%m%d000000')}"
        f"&enddatetime={dt.strftime('%Y%m%d235959')}&maxrecords=250"
    )
    try:
        r = requests.get(qs, timeout=10)
        if r.status_code != 200 or not r.text.strip(): return 0.0
        data = r.json()
        tones = [a.get('semtone', 0) for a in data.get('articles', [])]
        return float(np.mean(tones)) if tones else 0.0
    except:
        return 0.0

sent = [{'Date': dt, 'Sentiment': get_gdelt_sentiment(dt)}
        for dt in pd.date_range(merged['Date'].min(), merged['Date'].max())]
sent_df = pd.DataFrame(sent)
merged = merged.merge(sent_df, on='Date', how='left')
merged['Sentiment'].fillna(method='ffill', inplace=True)
merged['ROC_5'] = merged['Price'].pct_change(periods=5)
merged['ROC_5'].fillna(method='bfill', inplace=True)

# Scale and Create Sequences
features = ['Price', 'Volume', 'ATR_14', 'VOL_10', 'Brent_Price', 'OVX', 'Sentiment', 'ROC_5']
scaler = MinMaxScaler()
merged[features] = scaler.fit_transform(merged[features])

seq_len, X, y = 10, [], []
for i in range(len(merged) - seq_len):
    X.append(merged[features].iloc[i:i+seq_len].values)
    y.append(merged['Price'].iloc[i+seq_len])
X, y = np.array(X), np.array(y)

# Train-test split
split = int(0.8 * len(X))
X_train, X_test = X[:split], X[split:]
y_train, y_test = y[:split], y[split:]

# Model
model = models.Sequential([
    layers.Input((seq_len, len(features))),
    layers.LSTM(96, dropout=0.1),
    layers.Dense(1)
])
model.compile(optimizer=optimizers.Adam(0.01), loss='mse')

# Training
model.fit(X_train, y_train, epochs=50, batch_size=16, validation_split=0.1, shuffle=False, verbose=2)

# Prediction and Rescaling
y_pred = model.predict(X_test).flatten()
pmin, pmax = scaler.data_min_[features.index('Price')], scaler.data_max_[features.index('Price')]
y_test_rescaled = y_test * (pmax - pmin) + pmin
y_pred_rescaled = y_pred * (pmax - pmin) + pmin

# Plot Actual vs Predicted
plt.figure(figsize=(10, 5))
plt.plot(y_test_rescaled, label='Actual Price')
plt.plot(y_pred_rescaled, label='Predicted Price')
plt.title('Advanced LSTM - Actual vs. Predicted Murban Prices')
plt.xlabel('Time Step')
plt.ylabel('Price (USD)')
plt.legend()
plt.grid()
plt.show()

# Error Analysis: RMSE / MAE
mae = mean_absolute_error(y_test_rescaled, y_pred_rescaled)
rmse = np.sqrt(mean_squared_error(y_test_rescaled, y_pred_rescaled))
print("Mean Absolute Error:", round(mae, 2))
print("Root Mean Squared Error:", round(rmse, 2))

# Hedging Decision Simulation
actual = y_test_rescaled
predicted = y_pred_rescaled

def classify_action(current_price, next_price, threshold):
    diff = next_price - current_price
    if diff > threshold:
        return "BUY"
    elif diff < -threshold:
        return "SELL"
    else:
        return "HOLD"

thresholds = [0.25, 0.5, 0.75, 1.0]
print("Threshold | Accuracy (%) | Correct / Total")
print("-------------------------------------------")

for thresh in thresholds:
    correct = 0
    total = len(actual) - 1

    for i in range(total):
        pred_action = classify_action(predicted[i], predicted[i+1], threshold=thresh)
        actual_action = classify_action(actual[i], actual[i+1], threshold=thresh)

        if pred_action == actual_action:
            correct += 1

    accuracy = correct / total * 100
    print(f"{thresh:<9} | {accuracy:>11.2f}% | {correct} / {total}")

# Sample day evaluation
random_days = sorted(random.sample(range(len(actual) - 1), 5))
print("\nSample Day | Predicted Action | Actual Action | Match")
print("--------------------------------------------------------")

for i in random_days:
    pred_action = classify_action(predicted[i], predicted[i+1], threshold=1.0)
    actual_action = classify_action(actual[i], actual[i+1], threshold=1.0)
    match = "✅" if pred_action == actual_action else "❌"
    print(f"{i:<11} | {pred_action:^16} | {actual_action:^14} | {match}")
